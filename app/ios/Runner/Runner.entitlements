<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Enlaces de invitación https://gifthuddle.app/i#<id> (ADR 0002 y
	     0004). Los confirma el fichero apple-app-site-association de la web. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:gifthuddle.app</string>
	</array>
</dict>
</plist>
