<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Sincronizacion cifrada (docs/adr/0002-sincronizacion.md). Solo se usa
         con un servidor configurado con la opcion dart-define SYNC_HOST. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Leer el QR de emparejar. El lector es ZXing dentro de la app
         (qr_code_scanner_plus): sin ML Kit ni servicios de Google. La camara
         no es obligatoria: tambien se entra con una invitacion. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <application
        android:label="Gift Huddle"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Una sola Activity/motor, también desde la tarea de Archivos.
                 singleTask reutiliza la tarea por su componente raíz; la
                 afinidad vacía protege frente a StrandHogg en Android 8-10.
                 VIEW/SEND llegan al intent original en onNewIntent, con su
                 permiso temporal de lectura, sin actividad intermediaria. -->
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- app_links recibe las invitaciones y document_exchange los
                 documentos. Evita que Flutter los envie tambien al router. -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Abrir un envio .gifthuddle (o .regalos antiguo) desde WhatsApp, Archivos, etc. Solo
                 content://: nunca file://, para no leer ficheros privados. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content" android:mimeType="application/vnd.gifthuddle"/>
                <data android:mimeType="application/octet-stream"/>
            </intent-filter>
            <!-- Lo mismo para gestores de ficheros que dan otro tipo MIME:
                 se reconoce por la extension. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content" android:host="*" android:mimeType="*/*"/>
                <data android:pathPattern=".*\\.gifthuddle"/>
                <data android:pathPattern=".*\\..*\\.gifthuddle"/>
                <data android:pathPattern=".*\\..*\\..*\\.gifthuddle"/>
                <data android:pathPattern=".*\\.regalos"/>
                <data android:pathPattern=".*\\..*\\.regalos"/>
                <data android:pathPattern=".*\\..*\\..*\\.regalos"/>
            </intent-filter>
            <!-- Compartir un envio .gifthuddle (o .regalos antiguo) hacia la app. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/vnd.gifthuddle"/>
                <data android:mimeType="application/octet-stream"/>
            </intent-filter>
            <!-- Pendiente de dominio: enlaces https://<dominio>/s#... con
                 app_links. Se activara al tener dominio (el filtro con
                 android:autoVerify y el assetlinks.json).
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="DOMINIO" android:path="/s"/>
            </intent-filter>
            -->
            <!-- Invitaciones https://gifthuddle.app/i#<id> (ADR 0002 y
                 0004), las del QR «Está aquí» y las del enlace «Está lejos».
                 Lo verifica web/public/.well-known/assetlinks.json; el
                 fragmento con el id nunca llega a la web. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="gifthuddle.app" android:path="/i"/>
            </intent-filter>
        </activity>
        <!-- zxing-android-embedded trae una pantalla de lectura propia que la
             app no usa: el lector va incrustado en Unirme con QR. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            tools:node="remove"/>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
